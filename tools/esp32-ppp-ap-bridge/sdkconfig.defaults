# lwIP: PPP client + NAT between the PPP link and the SoftAP
CONFIG_LWIP_PPP_SUPPORT=y
CONFIG_LWIP_IP_FORWARD=y
CONFIG_LWIP_IPV4_NAPT=y
CONFIG_LWIP_MAX_SOCKETS=16

# UART0 (the USB-serial chip) carries PPP, so the log console moves to UART1
# (TX=GPIO17, RX=GPIO16). Attach a second USB-UART adapter there to see logs.
CONFIG_ESP_CONSOLE_UART_CUSTOM=y
CONFIG_ESP_CONSOLE_UART_NUM=1
CONFIG_ESP_CONSOLE_UART_TX_GPIO=17
CONFIG_ESP_CONSOLE_UART_RX_GPIO=16
CONFIG_ESP_CONSOLE_UART_BAUDRATE=115200
CONFIG_BOOTLOADER_LOG_LEVEL_NONE=y

CONFIG_ESPTOOLPY_FLASHSIZE_4MB=y
